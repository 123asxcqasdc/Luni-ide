# Нормализация переводов строк: в репозитории — LF, при checkout — родные для ОS.
* text=auto

# Явные бинарники — никогда не трогать переводы строк.
*.exe   binary
*.EXE   binary
*.ico   binary
*.png   binary
*.woff2 binary
*.zip   binary
*.sys   binary
*.SYS   binary
*.dll   binary
*.DLL   binary
*.cat   binary
*.CAT   binary
*.inf   binary
*.INF   binary

# Linux-упаковка: только LF, иначе .desktop и launcher-скрипты ломаются
*.desktop     text eol=lf
*.desktop.in  text eol=lf
*.metainfo    text eol=lf
*.metainfo.xml.in text eol=lf
*.in          text eol=lf
*.sh          text eol=lf
*.py          text eol=lf
*.md          text eol=lf
